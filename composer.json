{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.0.0",
        "ext-apcu": "^5.1.7",
        "laravel/framework": "5.3.*",
        "components/jquery": "~2.2.4",
        "twbs/bootstrap-sass": "3.3.*",
        "maatwebsite/excel": "~2.1.0",
        "predis/predis": "^1.1",
        "webpatser/laravel-uuid": "^2.0",
        "aws/aws-sdk-php": "~3.0",
        "simplesoftwareio/simple-sms": "3.0.*",
        "nexmo/client": "@beta",
        "nexmo/laravel": "1.0.0-beta3",
        "laravel/passport": "^1.0",
        "laravel-notification-channels/telegram": "^0.0.1"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "~5.0",
        "symfony/css-selector": "3.1.*",
        "symfony/dom-crawler": "3.1.*",
        "barryvdh/laravel-debugbar": "^2.3"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Gordesch\\Laravel-Sms\\": "packages/gordesch/laravel-sms/src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
